OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 可选：指定 SQLite 数据库路径。缺省为 data/chat-web.sqlite。
# CHAT_WEB_DB_PATH=/absolute/path/to/chat-web.sqlite

# 可选：仅在全新数据库首次初始化时导入。之后可在设置中管理提供方。
OPENAI_COMPATIBLE_PROVIDERS='[{"id":"openai","name":"OpenAI","baseURL":"https://api.openai.com/v1","apiKeyEnv":"OPENAI_API_KEY"},{"id":"local","name":"Local SGLang","baseURL":"http://localhost:30000/v1","apiKeyEnv":""}]'
